# SKYJUMPERS BACKEND CONFIGURATION
# Copy this file to .env and replace placeholders with real values.
# NEVER commit the real .env file.

# Environment (local, test, staging, production)
DJANGO_ENV=local

# Security
DJANGO_SECRET_KEY=replace-this-with-a-very-long-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://skyjumpers:skyjumpers_pass@localhost:5432/skyjumpers_db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Kiosk / Hardware Integration
MACHINE_API_TOKEN_SECRET=replace-with-machine-secret
